PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string. Example for local dev:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendance
DATABASE_URL=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# bcrypt cost factor (10-12 typical for dev)
BCRYPT_ROUNDS=10

# Face matching: max Euclidean distance accepted between a live descriptor
# and an enrolled descriptor for attendance to be marked. Lower = stricter.
# Typical face-api.js values: 0.5-0.6.
FACE_MATCH_THRESHOLD=0.6

# Anti-spoofing. When "true"/"1", the server accepts face-mark requests
# without a client liveness proof. MUST be set together with the client's
# VITE_SKIP_LIVENESS=true. Default false keeps the proof-of-life gate on.
# LIVENESS_OPTIONAL=false
