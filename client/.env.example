VITE_API_BASE=http://localhost:4000

# --- Face-scan liveness (client-side) ---
# VITE_SKIP_LIVENESS=true   # disable on-camera anti-spoofing entirely (client side).
#                           # Must match the server's LIVENESS_OPTIONAL=true.
# VITE_LIVENESS_FAST=true   # default. ~0.5s EAR-based motion check.
# VITE_LIVENESS_STRICT=true # use the old blink/head-turn path instead of fast mode.
